<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Caller check (CallerCheck.kt): who is calling, looked up in contacts. Only yes/no is kept. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Android 11+ package visibility: without these, getPackageInfo() always fails and
         remote-access apps are never detected. Keep in sync with RealSignalSource.REMOTE_APPS.
         Package names to verify on a real device before the demo. -->
    <queries>
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.host.market" />
        <package android:name="com.carriez.flutter_hbb" />
        <package android:name="com.rustdesk.rustdesk" />
        <package android:name="com.sand.airdroid" />
        <package android:name="com.sand.airdroidbiz" />
    </queries>

    <application>
        <receiver android:name=".session.CallerCheckReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
